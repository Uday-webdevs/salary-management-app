{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "allowJs": true,
    "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "prisma/seed.ts"]
}
